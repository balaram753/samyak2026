// SAMYAK 2026 website on Cloudflare (static assets, single-page app).
// Deploy: npm run build && npx wrangler deploy
{
  "name": "samyak2026",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    // /team, /events/<id>, /core-register/<token>, ... are client-side routes.
    "not_found_handling": "single-page-application"
  }
}
