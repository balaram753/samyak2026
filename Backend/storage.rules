rules_version = '2';
service firebase.storage {
  // All new files go to Cloudflare R2 through the SAMYAK Worker. Firebase Storage
  // is read-only: existing files stay viewable, nothing new can be uploaded.
  match /b/{bucket}/o {
    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email in ['udaykiranvempati123@gmail.com', 'balaram777.ch@gmail.com', 'harshasai955@gmail.com']
      );
    }

    // Public Event Files
    match /events/{eventId}/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // Private Student College ID Cards
    match /users/{uid}/id-card/{fileName} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false;
    }

    // Private Payment Proof Screenshots
    match /users/{uid}/payments/{regId}/{fileName} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false;
    }

    // User Profile Avatars
    match /users/{uid}/avatars/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    // Public Gallery Photos (Community & Fest Captures)
    match /gallery_photos/{photoId} {
      allow read: if true;
      allow create: if false;
      allow delete: if isAdmin();
    }

    // Public Fest Media & Assets
    match /media/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
