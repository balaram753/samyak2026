# Cloudflare R2 S3 Storage Configuration
VITE_R2_ACCOUNT_ID=6fd3838fd505ee00ff61f46eebf9c294
VITE_R2_BUCKET_NAME=samyak
VITE_R2_ENDPOINT=https://6fd3838fd505ee00ff61f46eebf9c294.r2.cloudflarestorage.com

# R2 access keys are SERVER-ONLY. Never add them as VITE_ variables: Vite copies
# every VITE_* value into the public browser bundle. The website uploads through
# the SAMYAK Worker (VITE_CLOUD_API_URL), which uses an R2 binding and needs no keys.
# Only for local Node scripts that talk to R2 directly:
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# Public URL: In R2 Bucket Settings -> Public Access:
# Turn on "R2.dev subdomain" (e.g. https://pub-xxxxxxxxxxxxxx.r2.dev) or connect a Custom Domain
VITE_R2_PUBLIC_URL=

# ImgBB fallback uploader (https://api.imgbb.com/)
VITE_IMGBB_API_KEY=

# Platform Maintenance Mode (true / false)
VITE_MAINTENANCE_MODE=false

# Fest pass fee in rupees (payment page, QR amount, workshop gating text)
VITE_FEST_FEE=349
