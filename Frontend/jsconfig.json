{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": false,
    "forceConsistentCasingInFileNames": false,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@backend": ["src/backend/index.js"],
      "@backend/*": ["src/backend/*"],
      "@services/*": ["src/services/*"],
      "@components/*": ["src/components/*"],
      "@pages/*": ["src/pages/*"],
      "@designcodeio/threeui": ["src/threeui/index.ts"],
      "@designcodeio/threeui/*": ["src/threeui/*"]
    }
  },
  "include": ["src"]
}
